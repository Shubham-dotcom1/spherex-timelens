# SPHEREx TimeLens - Backend Environment Configuration Template
# Team CodeGenesis - NASA Space Apps Challenge 2026

# Server Settings
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# NASA / IPAC IRSA TAP Archive Configuration
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP/sync
IRSA_TIMEOUT_SECONDS=30
IRSA_CACHE_DIR=cache/irsa

# Local FITS Science Archive (Relative or Absolute Path)
LOCAL_FITS_ARCHIVE_DIR=research/feasibility

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Instrument Calibration
PIXEL_SCALE_ARCSEC=6.2
DEFAULT_FOV_ARCMIN=15.0
DEFAULT_DETECTION_THRESHOLD_SIGMA=5.0
