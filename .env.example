# SPHEREx TimeLens - Environment Configuration Template
# Team CodeGenesis - NASA Space Apps Challenge 2026
# Copy this file to .env and adjust variables as needed for your deployment

# Server Environment
ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# NASA / IPAC IRSA TAP Archive Configuration
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP/sync
IRSA_TIMEOUT_SECONDS=30
IRSA_CACHE_DIR=cache/irsa

# Local FITS Science Archive (Directory with pre-cached Level-2 FITS files)
LOCAL_FITS_ARCHIVE_DIR=research/feasibility

# Security & CORS (Allowed Frontend Origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://spherex-timelens.vercel.app"]

# Astrometry & Instrument Parameters
PIXEL_SCALE_ARCSEC=6.2
DEFAULT_FOV_ARCMIN=15.0
DEFAULT_DETECTION_THRESHOLD_SIGMA=5.0
